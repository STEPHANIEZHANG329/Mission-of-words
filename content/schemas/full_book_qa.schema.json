{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "full_book_qa.schema.json",
  "title": "Computed 48-page book QA report. pass is production readiness and is never hand-edited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "book_id",
    "phase",
    "target_page_count",
    "page_count",
    "paid_image_calls",
    "estimated_spend_usd",
    "canon_bound_count",
    "all_canons_bound",
    "facing_page_parity_ok",
    "font_floors_ok",
    "answer_key_linkage_ok",
    "unique_content_ok",
    "unfilled_art_slots",
    "placeholder_assets_present",
    "interior_pdf_present",
    "blueprint_pass",
    "technical_pass",
    "production_pass",
    "pass",
    "failures",
    "blockers"
  ],
  "properties": {
    "book_id": { "type": "string" },
    "phase": { "type": "string" },
    "target_page_count": { "type": "integer" },
    "page_count": { "type": "integer" },
    "rendered_page_count": { "type": "integer", "minimum": 0 },
    "paid_image_calls": { "type": "integer", "minimum": 0 },
    "estimated_spend_usd": { "type": "number" },
    "canon_bound_count": { "type": "integer" },
    "all_canons_bound": { "type": "boolean" },
    "facing_page_parity_ok": { "type": "boolean" },
    "font_floors_ok": { "type": "boolean" },
    "answer_key_linkage_ok": { "type": "boolean" },
    "unique_content_ok": { "type": "boolean" },
    "maze_all_solvable": { "type": "boolean" },
    "maze_all_unique": { "type": "boolean" },
    "search_answer_keys_from_manifest": { "type": "boolean" },
    "raster_dpi_ok": { "type": "boolean" },
    "non_production_mark_present": { "type": "boolean" },
    "visual_readiness": { "type": "string" },
    "unfilled_art_slots": { "type": "integer", "minimum": 0 },
    "placeholder_assets_present": { "type": "boolean" },
    "interior_pdf_present": { "type": "boolean" },
    "preview_count": { "type": "integer", "minimum": 0 },
    "artwork_status_summary": { "type": "string" },
    "image_client_mode": { "type": "string" },
    "paid_generation_gate_implemented": { "type": "boolean" },
    "blueprint_pass": { "type": "boolean" },
    "technical_pass": { "type": "boolean" },
    "production_pass": { "type": "boolean" },
    "pass": { "type": "boolean" },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "page": { "type": "integer" },
          "type": { "type": "string" },
          "technical_ok": { "type": "boolean" },
          "visual_status": { "type": "string" },
          "artwork_status": { "type": ["string", "null"] }
        }
      }
    },
    "failures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
