{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "canon.schema.json",
  "title": "Source-locked Bible canon record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canon_id",
    "translation",
    "source_edition",
    "reference",
    "source_text",
    "child_paraphrase",
    "license",
    "license_note",
    "allowed_visual_motifs",
    "forbidden_claims"
  ],
  "properties": {
    "canon_id": { "type": "string", "minLength": 1 },
    "translation": { "type": "string", "minLength": 1 },
    "source_edition": { "type": "string", "minLength": 1 },
    "reference": { "type": "string", "minLength": 1 },
    "source_text": { "type": "string", "minLength": 1 },
    "child_paraphrase": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "enum": ["public_domain"] },
    "license_note": { "type": "string", "minLength": 1 },
    "lock_note": { "type": "string" },
    "allowed_visual_motifs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "forbidden_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
