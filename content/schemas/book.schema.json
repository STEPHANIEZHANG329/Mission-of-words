{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "book.schema.json",
  "title": "Bright Hearts book record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "book_id",
    "working_title",
    "audience",
    "trim_inches",
    "dpi",
    "interior",
    "safe_margin_inches",
    "min_instruction_pt",
    "min_puzzle_letter_pt",
    "min_answer_key_pt",
    "mission_ids"
  ],
  "properties": {
    "book_id": { "type": "string", "minLength": 1 },
    "working_title": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "trim_inches": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "dpi": { "type": "integer", "const": 300 },
    "interior": { "type": "string", "enum": ["black_and_white"] },
    "safe_margin_inches": { "type": "number", "minimum": 0.5 },
    "min_instruction_pt": { "type": "number", "minimum": 12 },
    "min_puzzle_letter_pt": { "type": "number", "minimum": 12 },
    "min_answer_key_pt": { "type": "number", "minimum": 9 },
    "mission_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "canon_ids": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
