{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "visual_qa.schema.json",
  "title": "Independent visual QA evidence. Missing or non-pass status fails prototype/production.",
  "type": "object",
  "required": ["asset_integration", "child_usability", "prompt_to_art", "pages"],
  "properties": {
    "asset_integration": { "$ref": "#/definitions/gate" },
    "child_usability": { "$ref": "#/definitions/gate" },
    "prompt_to_art": { "$ref": "#/definitions/gate" },
    "pages": {
      "type": "object",
      "required": ["1", "2", "3", "4"],
      "properties": {
        "1": { "$ref": "#/definitions/gate" },
        "2": { "$ref": "#/definitions/gate" },
        "3": { "$ref": "#/definitions/gate" },
        "4": { "$ref": "#/definitions/gate" }
      }
    },
    "owner_production_signoff": { "$ref": "#/definitions/gate" }
  },
  "definitions": {
    "gate": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail", "missing"] },
        "evidence_ref": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    }
  }
}
