{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "production_assets.schema.json",
  "title": "Complete 48-page production asset and prompt manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "book_id",
    "art_bible_version",
    "prompt_version",
    "character_bible_version",
    "paid_generation_authorized",
    "pages",
    "assets"
  ],
  "properties": {
    "book_id": { "type": "string" },
    "art_bible_version": { "type": "string" },
    "prompt_version": { "type": "string" },
    "character_bible_version": { "type": "string" },
    "paid_generation_authorized": { "type": "boolean", "const": false },
    "pages": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "type", "needs_ai_art", "layout", "asset_ids"],
        "properties": {
          "page": { "type": "integer", "minimum": 1, "maximum": 48 },
          "type": { "type": "string" },
          "mission_id": { "type": ["string", "null"] },
          "needs_ai_art": { "type": "boolean" },
          "layout": { "type": "string", "enum": ["ai_plus_code", "code_only"] },
          "asset_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reuses_activity_pages": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "production_asset.schema.json" }
    }
  }
}
